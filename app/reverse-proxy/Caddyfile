# 研究室LAN内アクセス用Reverse Proxy設定（Issue #14, HTTPS化: Issue #26）。
#
# knowledge.lab.local : Outline本体（研究者が直接触るアプリ）
# auth.lab.local       : Authentik（OIDCログイン画面・招待リンク経由の登録画面）
# portal.lab.local      : Chienami ポータル（Outline/Search選択画面, Issue #40）。
#                        配下のアプリはホスト名を分けずパスで配置する（ホスト名を増やすと
#                        全端末のhosts追記が必要になるため）。いずれも静的ファイルはCaddyが
#                        直接配信し、<パス>/api/* のみ chienami-api へプロキシする
#                        （同一オリジンのためCORS設定が不要）。
#                          /search/ : Chienami Search（セマンティック検索UI, Issue #36, #90）
#                          /points/ : Chienami Points（貢献ポイントのランキング, Issue #77）
#                          /invite/ : 招待リンク発行（ログイン済みの全員, Issue #81）
#
# OutlineのログインはAuthentikへブラウザリダイレクトするため、Authentik側も
# LAN内の他端末から到達できるホスト名を割り当てる必要がある（127.0.0.1限定のままでは
# ホストPC以外のブラウザから認可エンドポイント・招待リンクへアクセスできない）。
#
# *.lab.local は研究室内限定の名前のため、Let's Encrypt等の公的CAによる自動証明書発行
# （ACME）は利用できない。代わりにCaddy組み込みの内部CA（tls internal）でサーバ証明書を
# 自動発行・更新する。研究室メンバーの各端末には、このCaddyが生成したルートCA証明書を
# 一度だけ信頼登録してもらう必要がある（配布手順: docs/design/reverse-proxy-setup.md）。
#
# ホスト名をスキームなしで書くと、Caddyの自動HTTPS機能によりHTTP(80番)→HTTPS(443番)への
# リダイレクトも自動で設定される。

knowledge.lab.local {
	tls internal
	reverse_proxy outline:3000
}

auth.lab.local {
	tls internal
	reverse_proxy authentik-server:9000
}

portal.lab.local {
	tls internal

	# X-Authentik-* はforward_auth（下の /invite/*）を通過したときだけAuthentikが付ける。
	# クライアントが偽装したものは全経路で先に消す（chienami-apiは /search/api/ 等からも
	# 到達できるため、このヘッダの有無で /invitations のログイン判定をしている）。
	request_header -X-Authentik-*

	redir /search /search/
	redir /points /points/
	redir /invite /invite/

	handle_path /search/api/* {
		reverse_proxy api:8000
	}

	handle_path /search/* {
		root * /srv/search-ui
		file_server
	}

	handle_path /points/api/* {
		reverse_proxy api:8000
	}

	handle_path /points/* {
		root * /srv/points-ui
		file_server
	}

	# forward_authのログイン後コールバック等（組み込みOutpost）。
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik-server:9000
	}

	# 招待リンク発行ページ。Authentikにログイン済みの全員が通れる
	# （app/authentik/blueprints/invite-admin.yaml）。ログイン後に元のURLへ戻れるよう、
	# パスを削る前にforward_authを実行する（routeで記述順に実行させる）。
	handle /invite/* {
		route {
			forward_auth authentik-server:9000 {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username
			}
			uri strip_prefix /invite
			handle_path /api/* {
				reverse_proxy api:8000
			}
			handle {
				root * /srv/invite-ui
				file_server
			}
		}
	}

	handle {
		root * /srv/portal
		file_server
	}
}
