# Authentik（ローカル認証基盤）およびその専用データベース用の環境変数テンプレート。
# 実際に使う値は `authentik.env` にコピーして記入すること（.gitignoreでGit管理対象外）。
# cp authentik.env.example authentik.env
#
# docker.env（Outline用）とは別ファイルにしている理由:
# authentik-postgres と postgres（Outline用）はどちらも公式postgresイメージの仕様上
# POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD という同じ変数名を要求するため、
# 1つの環境変数ファイルを共有すると値が衝突する。

# --- Authentik専用データベース ---
POSTGRES_DB=authentik
POSTGRES_USER=authentik
# `openssl rand -hex 32` で生成した値を設定すること（docker.envのPOSTGRES_PASSWORDとは別の値にする）。
POSTGRES_PASSWORD=

# --- Authentik本体 ---
AUTHENTIK_POSTGRESQL__HOST=authentik-postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
# 上のPOSTGRES_PASSWORDと同じ値を設定すること。
AUTHENTIK_POSTGRESQL__PASSWORD=

# `openssl rand -base64 60 | tr -d '\n'` で生成した値を設定すること。
AUTHENTIK_SECRET_KEY=

# 匿名利用状況送信・自動アップデートチェック・エラーレポート送信を無効化し、
# 外部（goauthentik.io等）への通信を発生させない。
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
