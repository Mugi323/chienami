# Outline / PostgreSQL 用の環境変数テンプレート。
# 実際に使う値は `docker.env` にコピーして記入すること（.gitignoreでGit管理対象外）。
# cp docker.env.example docker.env

# --- Outline core ---
NODE_ENV=production

# 公開URL。Reverse Proxy（Issue #14）経由の研究室LAN内アクセス用ホスト名。
# knowledge.lab.local / auth.lab.local は研究室内のhosts設定またはDNSで
# Reverse Proxyを動かすホストのIPへ解決させること（docs/design/reverse-proxy-setup.md参照）。
# Caddyの内部CAによるHTTPS化（Issue #26）済みのため https:// を指定する。
URL=https://knowledge.lab.local
PORT=3000

# 研究室メンバー向けにデフォルト言語を日本語にする。
DEFAULT_LANGUAGE=ja_JP

# それぞれ `openssl rand -hex 32` で生成した別々の値を設定すること。
SECRET_KEY=
UTILS_SECRET=

# 未設定。#15でOIDCプロバイダ（大学OIDC or Keycloak/Authentik）を追加するまで
# ログインは完了できないが、本Issueの完了条件はOutlineの初期画面到達までとする。

# --- Database ---
# ユーザー名・パスワード・DB名は下の POSTGRES_* と一致させること。
DATABASE_URL=postgres://outline:CHANGE_ME@postgres:5432/outline
# postgres公式イメージはデフォルトでSSLを提供しないため、内部Docker network限定で無効化する。
PGSSLMODE=disable
POSTGRES_USER=outline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=outline

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- File storage ---
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Reverse Proxy + TLS導入（#14, #26）後は true にする。
FORCE_HTTPS=true

# --- Qdrant（Phase 3検索用ベクトルDB, Issue #30） ---
# QDRANT__SERVICE__API_KEY はQdrant自身が読む環境変数名（Qdrant公式の設定キー、ダブルアンダースコアは階層区切り）。
# QDRANT_API_KEY は同じ値をindexer/検索API等のクライアント側が読む用。setup.shが同一値を自動生成して両方に埋め込む。
QDRANT__SERVICE__API_KEY=
QDRANT_API_KEY=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chienami_documents

# --- Embedding（text-embeddings-inference, Qwen3-Embedding-0.6B, Issue #30） ---
EMBEDDING_URL=http://embedding:80

# --- chienami-indexer（Phase 3, Issue #32） ---
# OutlineのAPIキー。Outline管理画面の Settings → API & Apps で発行する
# （手順: docs/design/indexer-setup.md）。この値が無いとindexerは起動時にエラー終了する。
OUTLINE_API_TOKEN=
# コンテナ間通信用の内部URL（外部到達性に依存させない）。
OUTLINE_INTERNAL_URL=http://outline:3000
# 索引化サイクルの実行間隔（秒）。
INDEXER_INTERVAL_SECONDS=600
# 1チャンクあたりの目標文字数・前チャンクとのオーバーラップ文字数（初期値）。
# Chunking方針は評価Issueの結果次第で調整する（design書5.3節）。
INDEXER_CHUNK_SIZE=1000
INDEXER_CHUNK_OVERLAP=100

# --- chienami-api（Phase 3検索API, Issue #34） ---
# 検索結果のデフォルト件数・上限件数。
API_SEARCH_DEFAULT_LIMIT=10
API_SEARCH_MAX_LIMIT=50

# --- LLM（llama.cpp, Phase 4, Issue #48） ---
# LLAMA_API_KEY はllama.cpp自身が読む環境変数名（llama.cpp公式のCLI引数 --api-key に対応）。
# setup.shが自動生成する。chienami-apiがLLMを呼び出す際にもこの値を使う。
LLAMA_API_KEY=
LLM_URL=http://llm:80

# --- Outline OIDC（Authentik連携, Issue #21） ---
# Authentik管理画面でOutline用のOIDC Provider/Applicationを作成した後、発行された
# Client ID / Client Secretを設定する。
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ブラウザからの認可リクエストで使うため、ブラウザから到達可能なURLを指定する。
# Reverse Proxy（Issue #14）経由でauth.lab.localからAuthentikへ到達する。
# Caddyの内部CAによるHTTPS化（Issue #26）済みのため https:// を指定する。
OIDC_AUTH_URI=https://auth.lab.local/application/o/authorize/
# トークン交換・ユーザー情報取得はOutlineコンテナからサーバー間通信で行うため、
# Docker内部ネットワークのホスト名を指定する（外部到達性に依存させない）。
OIDC_TOKEN_URI=http://authentik-server:9000/application/o/token/
OIDC_USERINFO_URI=http://authentik-server:9000/application/o/userinfo/
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Authentik
# Authentik本体・専用DBの設定は config/authentik.env.example（別ファイル）を参照。
