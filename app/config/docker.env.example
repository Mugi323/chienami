# Outline / PostgreSQL 用の環境変数テンプレート。
# 実際に使う値は `docker.env` にコピーして記入すること（.gitignoreでGit管理対象外）。
# cp docker.env.example docker.env

# --- Outline core ---
NODE_ENV=production

# 公開URL。Reverse Proxy導入(#14)までは暫定でローカルアクセス用のURLを設定する。
# #14でReverse Proxy経由の https://knowledge.lab.local へ変更すること。
URL=http://localhost:3000
PORT=3000

# 研究室メンバー向けにデフォルト言語を日本語にする。
DEFAULT_LANGUAGE=ja_JP

# それぞれ `openssl rand -hex 32` で生成した別々の値を設定すること。
SECRET_KEY=
UTILS_SECRET=

# 未設定。#15でOIDCプロバイダ（大学OIDC or Keycloak/Authentik）を追加するまで
# ログインは完了できないが、本Issueの完了条件はOutlineの初期画面到達までとする。

# --- Database ---
# ユーザー名・パスワード・DB名は下の POSTGRES_* と一致させること。
DATABASE_URL=postgres://outline:CHANGE_ME@postgres:5432/outline
# postgres公式イメージはデフォルトでSSLを提供しないため、内部Docker network限定で無効化する。
PGSSLMODE=disable
POSTGRES_USER=outline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=outline

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- File storage ---
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Reverse Proxy + TLS導入(#14)後に true へ変更する。
FORCE_HTTPS=false
